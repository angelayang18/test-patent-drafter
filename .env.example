LLM_BASE_URL=http://96.248.110.124:8024/v1
LLM_MODEL=Qwen3.6-35B-A3B-FP8
LLM_API_KEY=your-api-key-here
# Per-request timeout for LLM calls (seconds). Patent sections can take 30–90+ seconds.
LLM_TIMEOUT_SECONDS=180
# Socket connect timeout (seconds)
LLM_CONNECT_TIMEOUT_SECONDS=30
# Retries after the first failed attempt (total attempts = retries + 1)
LLM_MAX_RETRIES=2
# Initial backoff between retries; doubles on each retry (seconds)
LLM_RETRY_BACKOFF_SECONDS=5
# Short timeout for /health LLM reachability probe (seconds)
LLM_HEALTH_PROBE_TIMEOUT_SECONDS=10
# Extraction: grouped (default) | single | parallel
EXTRACT_MODE=grouped
# Short-doc ceiling: sources at or below this size are sent in full.
# Longer sources use retrieve-then-extract (global head + ranked passages per
# field group) instead of blind head/tail truncation. Field citations use
# value-weighted lexical ranking and omit weak cover-page matches.
EXTRACT_MAX_SOURCE_CHARS=80000
# Mermaid PNG rendering for export (optional; default https://kroki.io)
# Install local renderer: npm install -g @mermaid-js/mermaid-cli
# MMDC_PATH=/path/to/mmdc
# KROKI_BASE_URL=https://kroki.io
CONFLUENCE_BASE_URL=https://opaida.atlassian.net/wiki
CONFLUENCE_USERNAME=you@opaida.com
CONFLUENCE_API_TOKEN=
CONFLUENCE_CLOUD_ID=0b194b78-59a3-45e9-a8c0-1e94a3dc5ccd
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Org-wide draft learning (SQLite corpus + attorney feedback distillation)
LEARNING_ENABLED=true
# LEARNING_DB_PATH=./backend/data/learning.db
# SECTION_REFLECTION_ENABLED=true
# Clerk auth (backend session verification). Get from the Clerk dashboard.
CLERK_SECRET_KEY=sk_test_your-secret-key-here
# Frontend also needs its own key in frontend/.env (Vite only reads env files
# from its own root, not this one): VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# JWKS URL for verifying Clerk session JWTs. Derived from the Clerk publishable
# key's base64-encoded frontend API domain (e.g. pk_test_<base64("faithful-mule-85.clerk.accounts.dev$")>
# → https://faithful-mule-85.clerk.accounts.dev/.well-known/jwks.json).
CLERK_JWKS_URL=https://faithful-mule-85.clerk.accounts.dev/.well-known/jwks.json
# USPTO Open Data Portal API key (for related-application lookups in Export).
# Get from data.uspto.gov under a USPTO.gov account with ID.me verification.
USPTO_ODP_API_KEY=your-odp-api-key-here
